{
  "name": "dokuwiki-pages-dev-port",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public --project-name dokutest --branch main",
    "deploy:locks": "wrangler deploy --config wrangler.page-locks.toml",
    "deploy:preview": "wrangler pages deploy public --project-name dokutest --branch preview",
    "db:migrate:local": "wrangler d1 migrations apply dokuwiki_pages_dev --local",
    "db:seed:local": "wrangler d1 execute dokuwiki_pages_dev --local --file seed/local.sql",
    "audit": "npm audit --audit-level=high",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:dry-run": "node scripts/import-dokuwiki.mjs --source ../dokuwiki --dry-run",
    "import:sql": "node scripts/import-dokuwiki.mjs --source ../dokuwiki --dry-run --sql-out .wrangler/dokuwiki-import.sql",
    "import:media-manifest": "node scripts/import-dokuwiki.mjs --source ../dokuwiki --dry-run --media-manifest-out .wrangler/dokuwiki-media-manifest.json",
    "import:hash-manifest": "node scripts/import-dokuwiki.mjs --source ../dokuwiki --dry-run --hash-manifest-out .wrangler/dokuwiki-hash-manifest.json",
    "import:verify-hashes": "node scripts/verify-import-hashes.mjs --manifest .wrangler/dokuwiki-hash-manifest.json --database dokuwiki_pages_dev --bucket dokuwiki-pages-dev-media --remote",
    "import:media-upload": "node scripts/upload-r2-media.mjs --manifest .wrangler/dokuwiki-media-manifest.json --bucket dokuwiki-pages-dev-media --remote",
    "backup:export": "node scripts/export-cloudflare-backup.mjs --database dokuwiki_pages_dev --bucket dokuwiki-pages-dev-media --remote",
    "backup:restore": "node scripts/restore-cloudflare-backup.mjs --database dokuwiki_pages_dev --bucket dokuwiki-pages-dev-media --remote",
    "cache:warm": "node scripts/warm-cache.mjs",
    "smoke": "node scripts/smoke-pages.mjs",
    "test:e2e": "node scripts/smoke-pages.mjs",
    "test:visual": "node scripts/visual-regression.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260507.0",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15",
    "wrangler": "^4.88.0"
  }
}
